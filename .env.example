APP_NAME="Moments Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST:-127.0.0.1}
DB_PORT=${MYSQLPORT:-3306}
DB_DATABASE=${MYSQLDATABASE:-moments_studio}
DB_USERNAME=${MYSQLUSER:-root}
DB_PASSWORD=${MYSQLPASSWORD:-}
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@momentsstudio.in"
MAIL_FROM_NAME="Moments Studio"

MOMENTS_STUDIO_PHONE="+91 98765 43210"
MOMENTS_STUDIO_WHATSAPP="919876543210"
MOMENTS_STUDIO_EMAIL="info@momentsstudio.in"
MOMENTS_STUDIO_ADDRESS="123, Diamond Street, New York, USA"
MOMENTS_STUDIO_INSTAGRAM="@momentsstudio"
MOMENTS_STUDIO_FACEBOOK="https://facebook.com/momentsstudio"
MOMENTS_STUDIO_YOUTUBE="https://youtube.com/@momentsstudio"
GOOGLE_MAPS_EMBED="https://maps.google.com/maps?q=New+York&output=embed"

VITE_APP_NAME="${APP_NAME}"
